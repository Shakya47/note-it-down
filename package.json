{
  "name": "note-it-down",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build --config vite.content.config.ts && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "tsc -b && vite build --config web/vite.config.ts",
    "deploy": "pnpm build:web && wrangler deploy"
  },
  "dependencies": {
    "@pip-it-up/core": "0.3.0",
    "@pip-it-up/react": "0.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.4.0",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "0.1.42",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.3",
    "wrangler": "^4.152.0"
  },
  "cloudflare": {
    "bindings": {
      "NOTES_STORE": {
        "description": "Stores each person's encrypted notes, one Durable Object per sync ID. Created automatically; nothing to fill in."
      }
    }
  }
}

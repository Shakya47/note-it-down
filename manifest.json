{
  "manifest_version": 3,
  "name": "Note It Down",
  "version": "1.0.0",
  "description": "A note-taking extension with floating Picture-in-Picture editor.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Note It Down"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "content.css"
      ]
    }
  ]
}
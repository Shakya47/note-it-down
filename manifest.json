{
  "manifest_version": 3,
  "name": "Note It Down",
  "version": "1.0.0",
  "description": "Floating, always-on-top notes on any page. Optional end-to-end encrypted sync to your phone, through a server you own.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Note It Down"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  }
}
